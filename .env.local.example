# Variables PUBLIQUES (aussi à poser dans Vercel). La clé « anon » est publique par
# conception : l'accès aux données est borné par les règles RLS de la base.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRÈTES. Côté serveur uniquement : routes /api/vote et /api/newsletter (Vercel) et
# scripts locaux. Jamais dans le navigateur, jamais préfixées NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Sel de l'empreinte d'IP des votes : 16 caractères minimum (openssl rand -hex 32).
VOTE_IP_SALT=
